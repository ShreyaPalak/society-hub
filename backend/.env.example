# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=8h

# Database (SQLite file path, relative to backend/)
DATABASE_FILE=./db/society.db

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Overdue defaults (used only if not present in settings table on first boot)
DEFAULT_OVERDUE_THRESHOLD_DAYS=3

# Email (mock/dev transport by default - logs instead of sending)
EMAIL_TRANSPORT=console
# If EMAIL_TRANSPORT=smtp, fill these:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@societyhub.local
